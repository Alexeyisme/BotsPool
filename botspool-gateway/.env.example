# BotsPool Gateway minimal environment template
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/botspool_gateway
REDIS_URL=redis://127.0.0.1:6379/0

# Generate a fresh RSA keypair before deployment and paste the contents below.
# Do not commit real keys to version control.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=2592000
