# BotsPool Gateway Docker Environment Configuration

# This file is used specifically for Docker deployments
# It overrides defaults when running in Docker containers

# ============================================
# Application Settings
# ============================================
APP_NAME=BotsPool Gateway
APP_VERSION=0.1.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ============================================
# Database Configuration (Docker Network)
# ============================================
# Use Docker service names for internal networking
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres-gateway:5432/botspool_gateway
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# ============================================
# Redis Configuration (Docker Network)
# ============================================
# Use Docker service name for internal networking
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_DECODE_RESPONSES=true

# ============================================
# JWT Configuration
# ============================================
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=2592000
JWT_ISSUER=botspool.ai
JWT_AUDIENCE=botspool-api

# JWT Private Key (PEM format) - REQUIRED
# Generate keys using: python ../scripts/generate-jwt-keys.py
# Then copy the output here, or store in Docker secrets
JWT_PRIVATE_KEY=

# JWT Public Key (PEM format) - REQUIRED
JWT_PUBLIC_KEY=

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=http://localhost:3000,https://botspool.ai
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ============================================
# Graph Service Configuration
# ============================================
GRAPH_REQUEST_TIMEOUT=30
GRAPH_HEARTBEAT_INTERVAL=60
GRAPH_STALE_THRESHOLD=180

# ============================================
# Monitoring
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090

