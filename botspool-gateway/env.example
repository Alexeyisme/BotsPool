# BotsPool Gateway Environment Configuration

# ============================================
# Application Settings
# ============================================
APP_NAME=BotsPool Gateway
APP_VERSION=0.1.0
ENVIRONMENT=development  # Options: development, staging, production
DEBUG=false
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8000
WORKERS=1  # Number of worker processes (1 for development, 4+ for production)

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/botspool_dev
DATABASE_POOL_SIZE=20  # Connection pool size
DATABASE_MAX_OVERFLOW=10  # Maximum overflow connections
DATABASE_POOL_TIMEOUT=30  # Pool timeout in seconds
DATABASE_POOL_RECYCLE=3600  # Connection recycle time in seconds

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_DECODE_RESPONSES=true

# ============================================
# JWT Configuration
# ============================================
# IMPORTANT: Generate JWT keys using: python ../scripts/generate-jwt-keys.py
# OR use openssl commands in the JWT Key Generation section below

JWT_ALGORITHM=RS256  # Must be RS256 for security
JWT_ACCESS_TOKEN_EXPIRY=3600  # 1 hour in seconds
JWT_REFRESH_TOKEN_EXPIRY=2592000  # 30 days in seconds
JWT_ISSUER=botspool.ai
JWT_AUDIENCE=botspool-api

# JWT Private Key (PEM format) - REQUIRED for authentication
# Generate with: openssl genrsa -out private_key.pem 2048
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
# Paste your private key here (can span multiple lines)
-----END PRIVATE KEY-----

# JWT Public Key (PEM format) - REQUIRED for authentication  
# Generate with: openssl rsa -in private_key.pem -pubout -out public_key.pem
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
# Paste your public key here (can span multiple lines)
-----END PUBLIC KEY-----

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# ============================================
# Graph Service Configuration
# ============================================
GRAPH_REQUEST_TIMEOUT=30  # Timeout in seconds for graph requests
GRAPH_HEARTBEAT_INTERVAL=60  # Heartbeat interval in seconds
GRAPH_STALE_THRESHOLD=180  # Stale threshold in seconds

# ============================================
# Monitoring
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090

