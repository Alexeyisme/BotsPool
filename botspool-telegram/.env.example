# BotsPool Telegram Bot Environment Template
# Fill these values from deployment secrets before running in production.

TELEGRAM_BOT_TOKEN=
GATEWAY_URL=http://gateway:8000
REDIS_URL=redis://redis:6379/0
NOTIFICATION_API_KEY=
NOTIFICATION_PORT=8081
# Generate a 32-byte base64 key (e.g. via `python - <<'PY' ...`) and keep it secret.
CREDENTIAL_ENCRYPTION_KEY=

# Optional overrides
SESSION_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres-gateway:5432/botspool_gateway
SESSION_DEFAULT_TTL_SECONDS=86400
