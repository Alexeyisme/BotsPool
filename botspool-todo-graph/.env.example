# BotsPool ToDo Graph Environment Configuration

# Core settings
ENVIRONMENT=development
GATEWAY_URL=http://localhost:8000
GRAPH_ENDPOINT=http://botspool-todo-graph:8001
INSTANCE_ID=todo-local

# Storage
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/botspool_todograph
REDIS_URL=redis://localhost:6379/0

# LangGraph / LLM Providers
# Supply real provider keys via deployment secrets. Leave blank in version control.
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING_V2=true

# Notification Service
NOTIFICATION_SERVICE_URL=http://botspool-notification-service:8090
# Match the API key configured for the notification service when deploying.
NOTIFICATION_API_KEY=
